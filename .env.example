# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- AWS -------------------------------------------------------------------
AWS_REGION=us-east-1

# --- AgentCore Runtime hosting the SAP MCP server --------------------------
# From `aws ssm get-parameter --name /sap_mcp_server/runtime/agent_arn`
AGENTCORE_AGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/sap_mcp_server-XXXXXXXX

# --- Cognito machine-to-machine auth for the MCP endpoint ------------------
# From Secrets Manager secret `sap_mcp_server/cognito/oauth2_config`
COGNITO_TOKEN_ENDPOINT=https://your-domain.auth.us-east-1.amazoncognito.com/oauth2/token
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=your-resource-server-id/read your-resource-server-id/write

# --- SAP -------------------------------------------------------------------
# Base path for OData services. SAP credentials are NOT set here - the MCP
# server reads them from AWS Secrets Manager on the server side.
SAP_BASE_URL=https://your-sap-host/sap/opu/odata/sap/
SAP_COMPANY_CODE=1010
SAP_CURRENCY=EUR

# Posting and document date used when parking. Must fall inside an open SAP
# posting period; today's date will fail if the books are closed for it.
SAP_POSTING_DATE=2025-03-15

# --- Invoice references ----------------------------------------------------
# Each parked invoice is tagged <PREFIX>-<n>. SupplierInvoiceIDByInvcgParty is
# limited to 16 characters, so a 12-digit AWS account id plus -N fits exactly.
INVOICE_REFERENCE_PREFIX=000000000000

# --- Bedrock Knowledge Bases -----------------------------------------------
# List them with:
#   aws bedrock-agent list-knowledge-bases --region us-east-1 \
#     --query 'knowledgeBaseSummaries[].[knowledgeBaseId,name]' --output table
# Ids are 10 characters, uppercase alphanumeric.
SOP_KNOWLEDGE_BASE_ID=
API_KNOWLEDGE_BASE_ID=

# By default the SOP clause is read from the markdown in the repository and the
# knowledge base is the fallback: the managed chunker splits step tables away
# from their headings, so retrieval can return a correct clause with only part
# of its procedure. Set this to 1 to make retrieval drive the answer instead -
# passages stay scoped to one document and are parsed one at a time, so the
# clause is right, but it may carry fewer steps than the repository copy.
FORCE_SOP_RETRIEVAL=

# --- Model -----------------------------------------------------------------
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Concurrent vision reads per batch. Each document is one Bedrock call of
# roughly ten seconds; six at once turns a 50s batch into 12s. Raising it past
# the size of a normal batch buys nothing and risks ThrottlingException.
EXTRACT_CONCURRENCY=6
